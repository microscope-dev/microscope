microscope-views 1







view go `[]uint8` {
    show sequence(len(self)) for i in range(len(self)) => self[i]
    format self as utf8
}


view go strings.Builder {
    show text(buf)
}


view go bytes.Buffer {
    check off <= len(buf)
    show if off == len(buf) {
        text(buf, 0)
    } else {
        text(&buf[off], len(buf) - off)
    }
}


view go `encoding/json/jsontext`.Value {
    show sequence(len(self)) for i in range(len(self)) => self[i]
    format self as utf8
}
