# Buffers are what they read or write, with the bytes they hold between.
view rust tokio::io::util::buf_reader::BufReader<_> {
    show value(inner)
    field buffered = cap - pos
}

view rust tokio::io::util::buf_writer::BufWriter<_> {
    show value(inner)
    field buffered = buf.len - written
}

view rust tokio::io::util::lines::Lines<_> {
    show value(reader)
}

# The futures that read and write, as what they still read or write and
# from or to what.
view rust tokio::io::util::read::Read<_> {
    show empty("reading up to {len(buf)} bytes from {*reader}")
}

view rust tokio::io::util::read_exact::ReadExact<_> {
    show empty("reading {len(buf.buf) - buf.filled} more bytes from {*reader}")
}

view rust tokio::io::util::write_all::WriteAll<_> {
    show empty("writing {len(buf)} bytes to {*writer}")
}

# The future Lines::next_line awaits, which reads from its lines' reader.
view rust core::future::poll_fn::PollFn<tokio::io::util::lines::**::next_line::`{async_fn#0}`::`{closure_env#0}`<_>> {
    show empty("reading a line from {f._ref__self->reader}")
    field lines = *f._ref__self
}

# The future a socket's operations await until the I/O driver finds the
# socket ready, by the readiness it waits for: readable (1), writable (2),
# or both. The socket is the awaiting frame's.
view rust tokio::runtime::io::scheduled_io::Readiness {
    let interest = inner(waiter).interest.0
    show match state {
        Done => empty("ready")
        _ => match interest {
            1 => empty("waiting until readable")
            2 => empty("waiting until writable")
            3 => empty("waiting until readable or writable")
            _ => empty("waiting for readiness {interest}")
        }
    }
}
