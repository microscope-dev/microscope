microscope-views 1

# tokio. Verified against tokio 1.52.3 and 1.53.2 by
# tests/fixtures/rust/tokio/values, whose markers say what each value shows.
#
# tokio wraps most of its state in cells of its own around std's (its loom
# UnsafeCell, Mutex, and atomics), which inner() steps through.

# A task's id, as tokio numbers its tasks.
view rust tokio::runtime::task::id::Id {
    show value(inner(inner(self)))
}

# A waker of a tokio task: its data is the task's header, whose vtable says
# where in the task its id is. Another waker shows as stored.
view rust core::task::wake::Waker {
    let header = waker.data as *tokio::runtime::task::core::Header
    show if waker.vtable == &global(`tokio::runtime::task::waker::WAKER_VTABLE`) {
        empty("task {*((waker.data as *u8 + header->vtable->id_offset) as *tokio::runtime::task::id::Id)}")
    } else {
        value(waker)
    }
}

# A join handle is its task's cell, whose type only the task's vtable says:
# a Cell<T, S> polled by poll::<T, S>.
view rust tokio::runtime::task::join::JoinHandle<_> {
    let header = inner(raw.ptr)
    show dynamic(header, tokio::runtime::task::core::Cell<T, S> of header->vtable->poll)
}

# A task's cell holds its future until it finishes, then its output until
# its join handle takes it.
view rust tokio::runtime::task::core::Cell<_, _> {
    let stage = inner(core.stage.stage)
    let task = core.task_id
    show match stage {
        Running => empty("task {task} pending")
        Consumed => empty("task {task}'s output taken")
        Finished => match stage.Finished.0 {
            Ok => value(stage.Finished.0.Ok.0)
            Err => value(stage.Finished.0.Err.0)
        }
    }
    field task = task
}

# A task that did not return, as tokio's own Display writes it. Its panic's
# payload is under [raw].
view rust tokio::runtime::task::error::JoinError {
    show match repr {
        Cancelled => empty("task {id} was cancelled")
        Panic => empty("task {id} panicked")
    }
}

# The tasks a semaphore's waiters belong to, in the order the semaphore
# serves them: from the back of its queue, where each waiter joins at the
# front.
view rust tokio::sync::batch_semaphore::Waitlist {
    type Waiter = tokio::sync::batch_semaphore::Waiter
    show sequence(_) for w in list(*(&queue.tail as *usize) as *Waiter, p => *(&inner(p->pointers).prev as *usize) as *Waiter)
        => inner(w->waker).Some.0
    field closed = closed
}

# A semaphore's permits count, shifted left by one, those it has left, and
# its low bit says it is closed.
view rust tokio::sync::batch_semaphore::Semaphore {
    let permits = inner(permits)
    show value(permits >> 1)
    field closed = (permits & 1) != 0
    field waiters = inner(waiters).data.value
}

view rust tokio::sync::semaphore::Semaphore {
    show value(ll_sem)
}

# A future that waits for permits: how many it still needs.
view rust tokio::sync::batch_semaphore::Acquire {
    let needed = queued ? inner(node.state) : num_permits
    show empty("waiting for {needed} of {num_permits} permits")
}

# A Mutex is a semaphore of one permit: held while that permit is out.
view rust tokio::sync::mutex::Mutex<T> {
    show value(c.value)
    field locked = inner(s.permits) >> 1 == 0
    field waiters = inner(s.waiters).data.value
}

view rust tokio::sync::mutex::MutexGuard<T> {
    show value(lock->c.value)
}

# An RwLock is a semaphore of mr permits: a reader takes one and a writer
# all of them. A waiter may hold some of the permits it waits for, and only
# the one the semaphore serves next can, so the readers are the permits out
# less those.
view rust tokio::sync::rwlock::RwLock<T> {
    type Waiter = tokio::sync::batch_semaphore::Waiter
    type Acquire = tokio::sync::batch_semaphore::Acquire
    let list = inner(s.waiters).data.value
    let next = *(&list.queue.tail as *usize) as *Waiter
    let held = next == 0 ? 0 : container_of(next, Acquire, node)->num_permits - inner(next->state)
    let out = mr - (inner(s.permits) >> 1) - held
    show value(c.value)
    field readers = out == mr ? 0 : out
    field writer = out == mr
    field waiters = list
}

view rust tokio::sync::rwlock::read_guard::RwLockReadGuard<T> {
    show value(*inner(data))
}

view rust tokio::sync::rwlock::write_guard::RwLockWriteGuard<T> {
    show value(*inner(data))
}

# An mpsc channel's messages are in blocks of slots, a slot ready once its
# bit in its block's ready_slots is set, from the receiver's index to the
# senders' tail position. Its senders and receiver present it, with what
# they say of it.
view rust tokio::sync::mpsc::chan::Chan<T, _> {
    type Block = tokio::sync::mpsc::block::Block<T>
    let rx = inner(rx_fields)
    let first = rx.list.index
    let end = inner(inner(tx).tail_position)
    show sequence(_) for b in list(inner(rx.list.head), p => inner(p->header.next) as *Block)
        let start = b->header.start_index
        let ready = inner(b->header.ready_slots)
        for s in range(len(b->values.0))
        if start + s >= first && start + s < end && ((ready >> s) & 1) != 0
        => b->values.0[s].0.value.value.value.0
}

# The future mpsc's recv awaits, which polls the channel its receiver
# holds.
view rust core::future::poll_fn::PollFn<tokio::sync::mpsc::**::recv::`{async_fn#0}`::`{closure_env#0}`<_>> {
    let chan = inner(f._ref__self__chan->inner.ptr)->data
    show empty("receiving; senders: {inner(chan.tx_count)}")
    field channel = chan
}

view rust tokio::sync::mpsc::bounded::Sender<T> {
    let chan = inner(chan.inner.ptr)->data
    show value(chan)
    field capacity = chan.semaphore.bound
    field closed = inner(chan.rx_fields).rx_closed || inner(chan.tx_count) == 0
    field senders = inner(chan.tx_count)
}

view rust tokio::sync::mpsc::bounded::Receiver<T> {
    let chan = inner(chan.inner.ptr)->data
    show value(chan)
    field capacity = chan.semaphore.bound
    field closed = inner(chan.rx_fields).rx_closed || inner(chan.tx_count) == 0
    field senders = inner(chan.tx_count)
}

view rust tokio::sync::mpsc::unbounded::UnboundedSender<T> {
    let chan = inner(chan.inner.ptr)->data
    show value(chan)
    field closed = inner(chan.rx_fields).rx_closed || inner(chan.tx_count) == 0
    field senders = inner(chan.tx_count)
}

view rust tokio::sync::mpsc::unbounded::UnboundedReceiver<T> {
    let chan = inner(chan.inner.ptr)->data
    show value(chan)
    field closed = inner(chan.rx_fields).rx_closed || inner(chan.tx_count) == 0
    field senders = inner(chan.tx_count)
}

# A oneshot channel holds its value once it is sent, until it is received.
# Its state's bits say the sender is done (2), having sent or been dropped,
# or the receiver closed it (4).
view rust tokio::sync::oneshot::Inner<T> {
    let state = inner(state)
    let held = inner(value)
    show if (state & 2) != 0 && held == Some {
        value(held.Some.0)
    } else if (state & 6) != 0 {
        empty("closed")
    } else {
        empty("empty")
    }
}

view rust tokio::sync::oneshot::Sender<T> {
    show if inner == None { empty("used") } else { value(inner(inner.Some.0.ptr)->data) }
}

view rust tokio::sync::oneshot::Receiver<T> {
    show if inner == None { empty("received") } else { value(inner(inner.Some.0.ptr)->data) }
}

# A watch channel's value, and its version, which counts by two above its
# closed bit.
view rust tokio::sync::watch::Shared<T> {
    let state = inner(state)
    show value(inner(value).data.value)
    field version = state >> 1
    field closed = (state & 1) != 0
    field receivers = inner(ref_count_rx)
}

view rust tokio::sync::watch::Sender<T> {
    show value(inner(shared.ptr)->data)
}

# A receiver has seen the value when its version is the channel's.
view rust tokio::sync::watch::Receiver<T> {
    let shared = inner(shared.ptr)->data
    show value(shared)
    field seen = inner(version) == (inner(shared.state) & -2)
}

# A broadcast channel keeps its last messages in a ring of slots, the
# message at position i in slot i & mask while the slot's position says so.
view rust tokio::sync::broadcast::Sender<T> {
    let shared = inner(shared.ptr)->data
    let tail = inner(shared.tail).data.value
    show empty("{tail.pos} sent")
    field receivers = tail.rx_cnt
    field closed = tail.closed
    field capacity = len(shared.buffer)
}

# A receiver's messages are those from its next position to the channel's
# tail that the ring still holds.
view rust tokio::sync::broadcast::Receiver<T> {
    let shared = inner(shared.ptr)->data
    let tail = inner(shared.tail).data.value
    check next <= tail.pos
    show sequence(_) for i in range(tail.pos - next)
        let slot = inner(shared.buffer[(next + i) & shared.mask]).data.value
        if slot.pos == next + i && slot.val == Some
        => slot.val.Some.0
    field lagged = tail.pos - next > len(shared.buffer)
}

# A Notify's state's low two bits say it is empty (0), has waiters (1), or
# holds a notification (2).
view rust tokio::sync::notify::Notify {
    type Waiter = tokio::sync::notify::Waiter
    let state = inner(state) & 3
    let list = inner(waiters).data.value
    show match state {
        0 => empty("empty")
        2 => empty("notified")
        1 => sequence(_) for w in list(*(&list.tail as *usize) as *Waiter, p => *(&inner(p->pointers).prev as *usize) as *Waiter)
            => inner(w->waker).Some.0
    }
}

# A future that waits for a Notify, by its state, and while it waits, by
# the notification its waiter holds once one is sent to it.
view rust tokio::sync::notify::Notified {
    let sent = inner(waiter.notification.0) != 0
    show match state {
        Init => empty("not yet waiting")
        Waiting => if sent { empty("notified") } else { empty("waiting for a notification") }
        Done => empty("notified")
    }
    field notify = *notify
}

# A sleep's deadline, against the runtime's own clock: the time its timer
# driver last read, its start and the milliseconds its wheel has turned
# since. A runtime that has been idle reads late. tokio 1.53 keeps the
# deadline and the runtime's handle in the sleep, and makes its timer only
# when it is first polled; 1.52 kept both in its timer; 1.47 kept them in a
# timer that was a struct, not yet one of a choice of timers, and its timer
# driver's state outside the choice of drivers that 1.51 added.
view rust tokio::time::sleep::Sleep {
    let at = deadline or entry.Traditional.0.deadline or entry.deadline
    let scheduler = driver or entry.Traditional.0.driver or entry.driver
    let handle = scheduler == MultiThread ? inner(scheduler.MultiThread.0.ptr)->data.driver : inner(scheduler.CurrentThread.0.ptr)->data.driver
    let time = handle.time.Some.0
    let start = inner(time.time_source.start_time)
    let wheel = inner(time.inner.Traditional.state).data.value.wheel or inner(time.inner.state).data.value.wheel
    let clock = start.tv_sec * 1000000000 + inner(start.tv_nsec) + wheel.elapsed * 1000000
    let until = inner(at).tv_sec * 1000000000 + inner(inner(at).tv_nsec)
    show if until <= clock {
        empty("elapsed")
    } else {
        empty("sleeping until +{(until - clock) / 1000000 as duration(ms)}")
    }
    field deadline = at
}

view rust tokio::time::interval::Interval {
    show value(*inner(delay))
    summary "every {period}: {*inner(delay)}"
}

view rust tokio::time::instant::Instant {
    show value(std)
}

# A JoinSet's tasks are the join handles in its two lists, of tasks that
# have woken it and of those that have not.
view rust tokio::task::join_set::JoinSet<T> {
    type Entry = tokio::util::idle_notified_set::ListEntry<tokio::runtime::task::join::JoinHandle<T>>
    let lists = inner(inner(inner.lists.ptr)->data).data.value
    show sequence(inner.length)
        for head in range(2)
        for e in list(*(&(head == 0 ? lists.notified : lists.idle).head as *usize) as *Entry, p => *(&inner(p->pointers).next as *usize) as *Entry)
        => e->value.0.value.value.0
}

# A socket is its file descriptor, which the source the I/O driver
# registered wraps in mio's type, std's, and std's own wrappers, as deep as
# std nests that kind of socket.
view rust tokio::net::tcp::stream::TcpStream {
    show match io.io {
        None => empty("deregistered")
        Some => empty("fd {io.io.Some.0.inner.inner.0.inner.0.0.fd.0}")
    }
}

view rust tokio::net::tcp::listener::TcpListener {
    show match io.io {
        None => empty("deregistered")
        Some => empty("fd {io.io.Some.0.inner.inner.0.inner.0.0.fd.0}")
    }
}

view rust tokio::net::udp::UdpSocket {
    show match io.io {
        None => empty("deregistered")
        Some => empty("fd {io.io.Some.0.inner.inner.0.inner.0.0.fd.0}")
    }
}

view rust tokio::net::unix::stream::UnixStream {
    show match io.io {
        None => empty("deregistered")
        Some => empty("fd {io.io.Some.0.inner.inner.0.0.0.fd.0}")
    }
}

view rust tokio::net::unix::listener::UnixListener {
    show match io.io {
        None => empty("deregistered")
        Some => empty("fd {io.io.Some.0.inner.inner.0.0.0.fd.0}")
    }
}

# A stream's halves are the stream they read or write.
view rust tokio::net::tcp::split::ReadHalf {
    show value(*self.0)
}

view rust tokio::net::tcp::split::WriteHalf {
    show value(*self.0)
}

view rust tokio::net::unix::split::ReadHalf {
    show value(*self.0)
}

view rust tokio::net::unix::split::WriteHalf {
    show value(*self.0)
}

view rust tokio::net::tcp::split_owned::OwnedReadHalf {
    show value(inner(inner.ptr)->data)
}

view rust tokio::net::tcp::split_owned::OwnedWriteHalf {
    show value(inner(inner.ptr)->data)
}

view rust tokio::net::unix::split_owned::OwnedReadHalf {
    show value(inner(inner.ptr)->data)
